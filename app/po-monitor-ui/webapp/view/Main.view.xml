<mvc:View
  controllerName="demo.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  height="100%"
>
  <Page title="PO UnBooked Quantity Monitor Agent" class="poMonitorPage">
    <content>
      <VBox class="sapUiSmallMargin poMonitorShell" busy="{monitor>/busy}">
        <OverflowToolbar class="poActionToolbar sapUiSmallMarginBottom">
          <Button text="Go" type="Emphasized" press="onGoPress" icon="sap-icon://refresh" tooltip="Fetch overdue purchase order items"/>
          <ToolbarSeparator/>
          <SearchField width="20rem" placeholder="Search PO, material, WBS or manager" liveChange="onSearch"/>
          <ToolbarSpacer/>
          <Button icon="sap-icon://action-settings" type="Transparent" press="onColumnSettings" tooltip="Column settings"/>
        </OverflowToolbar>

        <Text id="summary" text="{monitor>/summary}" maxLines="5" class="poSummary sapUiSmallMarginBottom"/>

        <ScrollContainer horizontal="true" vertical="false" width="100%">
          <Table id="poTable" class="poMonitorTable" width="100%" fixedLayout="true" growing="true" growingThreshold="25" sticky="ColumnHeaders,HeaderToolbar" items="{monitor>/pos}" noDataText="No overdue purchase order items found.">
            <headerToolbar>
              <OverflowToolbar class="poTableToolbar">
                <Title text="Open purchase order items" level="H3"/>
                <ToolbarSpacer/>
                <ObjectStatus text="{monitor>/visibleCount} items" state="Information" icon="sap-icon://table-view"/>
              </OverflowToolbar>
            </headerToolbar>
            <columns>
            <Column width="9rem" visible="{monitor>/columns/purchaseOrder}"><Text text="Purchase Order"/></Column>
            <Column width="5rem" visible="{monitor>/columns/item}"><Text text="Item"/></Column>
            <Column width="9rem" visible="{monitor>/columns/material}"><Text text="Material Number"/></Column>
            <Column width="16rem" visible="{monitor>/columns/materialDescription}"><Text text="Material Description"/></Column>
            <Column width="7rem" hAlign="End" visible="{monitor>/columns/orderQuantity}"><Text text="Order QTY"/></Column>
            <Column width="7rem" hAlign="End" visible="{monitor>/columns/openQuantity}"><Text text="Open QTY"/></Column>
            <Column width="5rem" visible="{monitor>/columns/unit}"><Text text="Unit"/></Column>
            <Column width="9rem" visible="{monitor>/columns/servicePerformer}"><Text text="Service Performer"/></Column>
            <Column width="12rem" visible="{monitor>/columns/servicePerformerName}"><Text text="Service Performer Name"/></Column>
            <Column width="12rem" visible="{monitor>/columns/performancePeriod}"><Text text="End Of Performance Period"/></Column>
            <Column width="10rem" visible="{monitor>/columns/projectId}"><Text text="Project ID"/></Column>
            <Column width="16rem" visible="{monitor>/columns/projectName}"><Text text="Project Name"/></Column>
            <Column width="15rem" visible="{monitor>/columns/workPackageId}"><Text text="WBS /Work Package ID"/></Column>
            <Column width="16rem" visible="{monitor>/columns/workPackageName}"><Text text="WBS/Work Package Name"/></Column>
            <Column width="11rem" visible="{monitor>/columns/costCenter}"><Text text="Cost Center"/></Column>
            <Column width="16rem" visible="{monitor>/columns/costCenterResponsible}"><Text text="Cost Center Responsible"/></Column>
            <Column width="14rem" visible="{monitor>/columns/projectManagerName}"><Text text="Project Manager Name"/></Column>
            <Column width="18rem" visible="{monitor>/columns/projectManagerEmail}"><Text text="Project Manager email"/></Column>
            <Column width="12rem" visible="{monitor>/columns/lastNotified}"><Text text="Last Notified"/></Column>
            <Column width="8rem" visible="{monitor>/columns/resolved}"><Text text="Resolved"/></Column>
            <Column width="12rem" visible="{monitor>/columns/completelyDelivered}"><Text text="Completely Delivered"/></Column>
            <Column width="14rem" visible="{monitor>/columns/notificationStatus}"><Text text="Notification Status"/></Column>
            </columns>
            <items>
            <ColumnListItem>
              <cells>
                <Text class="poNumberCell" visible="{monitor>/columns/purchaseOrder}" text="{monitor>purchaseOrder}"/>
                <Text visible="{monitor>/columns/item}" text="{monitor>item}"/>
                <Text visible="{monitor>/columns/material}" text="{monitor>material}"/>
                <Text visible="{monitor>/columns/materialDescription}" text="{monitor>materialDescription}"/>
                <Text visible="{monitor>/columns/orderQuantity}" text="{monitor>orderQuantity}"/>
                <Text visible="{monitor>/columns/openQuantity}" text="{monitor>openPurchaseOrderQuantity}"/>
                <Text visible="{monitor>/columns/unit}" text="{monitor>orderUnit}"/>
                <Text visible="{monitor>/columns/servicePerformer}" text="{monitor>servicePerformer}"/>
                <Text visible="{monitor>/columns/servicePerformerName}" text="{monitor>servicePerformerName}"/>
                <Text visible="{monitor>/columns/performancePeriod}" text="{monitor>performancePeriodEndDate}"/>
                <Text visible="{monitor>/columns/projectId}" text="{monitor>projectId}"/>
                <Text visible="{monitor>/columns/projectName}" text="{monitor>projectName}"/>
                <Text visible="{monitor>/columns/workPackageId}" text="{monitor>workPackageId}"/>
                <Text visible="{monitor>/columns/workPackageName}" text="{monitor>workPackageName}"/>
                <Text visible="{monitor>/columns/costCenter}" text="{monitor>costCenter}"/>
                <Text visible="{monitor>/columns/costCenterResponsible}" text="{monitor>costCenterResponsible}"/>
                <Text visible="{monitor>/columns/projectManagerName}" text="{monitor>projectManagerName}"/>
                <Text visible="{monitor>/columns/projectManagerEmail}" text="{monitor>projectManagerEmail}"/>
                <Text visible="{monitor>/columns/lastNotified}" text="{monitor>lastNotified}"/>
                <ObjectStatus visible="{monitor>/columns/resolved}" text="{= ${monitor>resolved} ? 'Resolved' : 'Open' }" state="{= ${monitor>resolved} ? 'Success' : 'None' }"/>
                <ObjectStatus visible="{monitor>/columns/completelyDelivered}" text="{= ${monitor>isCompletelyDelivered} ? 'Delivered' : 'Open' }" state="{= ${monitor>isCompletelyDelivered} ? 'Success' : 'None' }"/>
                <ObjectStatus visible="{monitor>/columns/notificationStatus}" text="{monitor>notificationStatus}" state="{= ${monitor>notificationStatus} === 'resolved' ? 'Success' : ${monitor>notificationStatus} === 'eligible' ? 'Information' : ${monitor>notificationStatus} === 'tracking-unavailable' ? 'Error' : 'Warning' }"/>
              </cells>
            </ColumnListItem>
            </items>
          </Table>
        </ScrollContainer>
      </VBox>
    </content>
  </Page>
</mvc:View>
