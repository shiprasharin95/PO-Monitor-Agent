<mvc:View
  controllerName="demo.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:ui="sap.ui.table"
  xmlns="sap.m"
  height="100%"
>
  <Page title="PO UnBooked Quantity Monitor Agent" class="poMonitorPage">
    <content>
      <VBox class="sapUiSmallMargin poMonitorShell" busy="{monitor>/busy}">
        <FlexBox class="poActionToolbar sapUiSmallMarginBottom" wrap="Wrap" alignItems="Center" width="100%">
          <Button text="Go" type="Emphasized" press="onGoPress" icon="sap-icon://refresh" tooltip="Fetch overdue purchase order items"/>
          <SearchField width="20rem" placeholder="Search PO, material, WBS or manager" liveChange="onSearch"/>
          <Select width="13rem" selectedKey="{monitor>/quantityFilter}" change="onQuantityFilterChange" tooltip="Filter by open quantity compared with order quantity">
            <items>
              <core:Item key="all" text="All quantity states"/>
              <core:Item key="fully-open" text="Open qty = Order qty"/>
              <core:Item key="partially-open" text="Partially unbooked"/>
              <core:Item key="zero-open" text="Zero open quantity"/>
            </items>
          </Select>
          <Button class="poColumnSettings" icon="sap-icon://action-settings" type="Transparent" press="onColumnSettings" tooltip="Column settings"/>
        </FlexBox>

        <Text id="summary" text="{monitor>/summary}" maxLines="5" class="poSummary sapUiSmallMarginBottom"/>

        <ui:Table
          id="poTable"
          class="poMonitorTable"
          rows="{monitor>/pos}"
          selectionMode="MultiToggle"
          selectionBehavior="RowSelector"
          visibleRowCountMode="Fixed"
          visibleRowCount="18"
          rowHeight="32"
          enableColumnReordering="true"
          width="100%"
        >
          <ui:extension>
            <OverflowToolbar class="poTableToolbar">
              <Title text="Open purchase order items" level="H3"/>
              <ToolbarSpacer/>
              <ObjectStatus text="{monitor>/visibleCount} items" state="Information" icon="sap-icon://table-view"/>
            </OverflowToolbar>
          </ui:extension>
          <ui:columns>
            <ui:Column width="9rem" visible="{monitor>/columns/purchaseOrder}"><Label text="Purchase Order"/><ui:template><Text class="poNumberCell" text="{monitor>purchaseOrder}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="5rem" visible="{monitor>/columns/item}"><Label text="Item"/><ui:template><Text text="{monitor>item}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="9rem" visible="{monitor>/columns/material}"><Label text="Material Number"/><ui:template><Text text="{monitor>material}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="16rem" visible="{monitor>/columns/materialDescription}"><Label text="Material Description"/><ui:template><Text text="{monitor>materialDescription}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="7rem" hAlign="End" visible="{monitor>/columns/orderQuantity}"><Label text="Order QTY"/><ui:template><Text text="{monitor>orderQuantity}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="7rem" hAlign="End" visible="{monitor>/columns/openQuantity}"><Label text="Open QTY"/><ui:template><Text text="{monitor>openPurchaseOrderQuantity}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="5rem" visible="{monitor>/columns/unit}"><Label text="Unit"/><ui:template><Text text="{monitor>orderUnit}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="9rem" visible="{monitor>/columns/servicePerformer}"><Label text="Service Performer"/><ui:template><Text text="{monitor>servicePerformer}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="12rem" visible="{monitor>/columns/performancePeriod}"><Label text="End Of Performance Period"/><ui:template><Text text="{monitor>performancePeriodEndDate}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="10rem" visible="{monitor>/columns/projectId}"><Label text="Project ID"/><ui:template><Text text="{monitor>projectId}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="16rem" visible="{monitor>/columns/projectName}"><Label text="Project Name"/><ui:template><Text text="{monitor>projectName}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="15rem" visible="{monitor>/columns/workPackageId}"><Label text="WBS / Work Package ID"/><ui:template><Text text="{monitor>workPackageId}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="16rem" visible="{monitor>/columns/workPackageName}"><Label text="WBS / Work Package Name"/><ui:template><Text text="{monitor>workPackageName}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="11rem" visible="{monitor>/columns/costCenter}"><Label text="Cost Center"/><ui:template><Text text="{monitor>costCenter}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="12rem" visible="{monitor>/columns/lastNotified}"><Label text="Last Notified"/><ui:template><Text text="{monitor>lastNotified}" wrapping="false"/></ui:template></ui:Column>
            <ui:Column width="8rem" visible="{monitor>/columns/resolved}"><Label text="Resolved"/><ui:template><ObjectStatus text="{= ${monitor>resolved} ? 'Resolved' : 'Open' }" state="{= ${monitor>resolved} ? 'Success' : 'None' }"/></ui:template></ui:Column>
            <ui:Column width="12rem" visible="{monitor>/columns/completelyDelivered}"><Label text="Completely Delivered"/><ui:template><ObjectStatus text="{= ${monitor>isCompletelyDelivered} ? 'Delivered' : 'Open' }" state="{= ${monitor>isCompletelyDelivered} ? 'Success' : 'None' }"/></ui:template></ui:Column>
            <ui:Column width="14rem" visible="{monitor>/columns/notificationStatus}"><Label text="Notification Status"/><ui:template><ObjectStatus text="{monitor>notificationStatus}" state="{= ${monitor>notificationStatus} === 'resolved' ? 'Success' : ${monitor>notificationStatus} === 'eligible' ? 'Information' : ${monitor>notificationStatus} === 'tracking-unavailable' ? 'Error' : 'Warning' }"/></ui:template></ui:Column>
          </ui:columns>
        </ui:Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
