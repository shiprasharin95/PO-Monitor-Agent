<mvc:View
  controllerName="demo.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  height="100%"
>
  <Page title="PO UnBooked Quantity Monitor Agent">
    <content>
      <VBox class="sapUiSmallMargin" busy="{monitor>/busy}">
        <Toolbar class="sapUiSmallMarginBottom">
          <Button text="GO" type="Emphasized" press="onGoPress" icon="sap-icon://refresh"/>
          <ToolbarSeparator/>
          <SearchField width="18rem" placeholder="Search PO, material, WBS or manager" liveChange="onSearch"/>
          <Select width="11rem" change="onDeliveryFilter" selectedKey="all" tooltip="Delivery status filter">
            <items>
              <core:Item key="all" text="All delivery status"/>
              <core:Item key="open" text="Open only"/>
              <core:Item key="delivered" text="Delivered only"/>
            </items>
          </Select>
          <ToolbarSpacer/>
          <Button icon="sap-icon://action-settings" type="Transparent" press="onColumnSettings" tooltip="Column settings"/>
        </Toolbar>

        <Text id="summary" text="{monitor>/summary}" class="sapUiSmallMarginBottom"/>

        <ScrollContainer horizontal="true" vertical="false" width="100%">
          <Table id="poTable" width="140rem" fixedLayout="false" items="{monitor>/pos}" noDataText="No matching open POs.">
            <columns>
            <Column visible="{monitor>/columns/purchaseOrder}"><Text text="Purchase Order"/></Column>
            <Column visible="{monitor>/columns/item}"><Text text="Item"/></Column>
            <Column hAlign="End" visible="{monitor>/columns/orderQuantity}"><Text text="Order Qty"/></Column>
            <Column hAlign="End" visible="{monitor>/columns/openQuantity}"><Text text="Open QTY"/></Column>
            <Column visible="{monitor>/columns/unit}"><Text text="Unit"/></Column>
            <Column visible="{monitor>/columns/material}"><Text text="Material Number"/></Column>
            <Column visible="{monitor>/columns/materialDescription}"><Text text="Material Description"/></Column>
            <Column visible="{monitor>/columns/performancePeriod}"><Text text="End of Performance Period"/></Column>
            <Column visible="{monitor>/columns/servicePerformer}"><Text text="Service Performer"/></Column>
            <Column visible="{monitor>/columns/servicePerformerName}"><Text text="Service Performer Name"/></Column>
            <Column visible="{monitor>/columns/wbsElement}"><Text text="WBS Element"/></Column>
            <Column visible="{monitor>/columns/workPackage}"><Text text="Work Package"/></Column>
            <Column visible="{monitor>/columns/projectManagerEmail}"><Text text="Project Manager Email"/></Column>
            <Column visible="{monitor>/columns/completelyDelivered}"><Text text="Completely Delivered"/></Column>
            </columns>
            <items>
            <ColumnListItem>
              <cells>
                <Text visible="{monitor>/columns/purchaseOrder}" text="{monitor>purchaseOrder}"/>
                <Text visible="{monitor>/columns/item}" text="{monitor>item}"/>
                <Text visible="{monitor>/columns/orderQuantity}" text="{monitor>orderQuantity}"/>
                <Text visible="{monitor>/columns/openQuantity}" text="{monitor>openPurchaseOrderQuantity}"/>
                <Text visible="{monitor>/columns/unit}" text="{monitor>orderUnit}"/>
                <Text visible="{monitor>/columns/material}" text="{monitor>material}"/>
                <Text visible="{monitor>/columns/materialDescription}" text="{monitor>materialDescription}"/>
                <Text visible="{monitor>/columns/performancePeriod}" text="{monitor>performancePeriodEndDate}"/>
                <Text visible="{monitor>/columns/servicePerformer}" text="{monitor>servicePerformer}"/>
                <Text visible="{monitor>/columns/servicePerformerName}" text="{monitor>servicePerformerName}"/>
                <Text visible="{monitor>/columns/wbsElement}" text="{monitor>wbsElement}"/>
                <Text visible="{monitor>/columns/workPackage}" text="{monitor>workPackage}"/>
                <Text visible="{monitor>/columns/projectManagerEmail}" text="{monitor>projectManagerEmail}"/>
                <Text visible="{monitor>/columns/completelyDelivered}" text="{monitor>isCompletelyDelivered}"/>
              </cells>
            </ColumnListItem>
            </items>
          </Table>
        </ScrollContainer>
      </VBox>
    </content>
  </Page>
</mvc:View>
